# Tab Organizer — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# === AI Provider ===
# Options: "gemini", "groq", "ollama"
# The extension will auto-fallback to ollama if the selected provider is unreachable or rate-limited.
AI_PROVIDER=gemini

# === Free-tier API Keys (no credit card required) ===
# Get a free Gemini key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a free Groq key at: https://console.groq.com/keys
GROQ_API_KEY=

# === Ollama (local fallback) ===
# Install from: https://ollama.com
# Default model used for classification: llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# === Backend Server ===
HOST=127.0.0.1
PORT=8742

# === Database ===
# Relative to the backend directory
DATABASE_URL=sqlite+aiosqlite:///./data/tab_organizer.db
